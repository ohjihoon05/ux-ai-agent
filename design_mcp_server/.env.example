# ============================================
# Component Library MCP Server Configuration
# ============================================

# Environment
NODE_ENV=development

# Server Ports
PORT=3000
API_PORT=3001

# Database
DB_PATH=./database.sqlite

# Security
CORS_ORIGIN=http://localhost:3000
SESSION_SECRET=your-secret-key-here-change-in-production

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Figma Integration (optional)
FIGMA_ACCESS_TOKEN=

# Logging
LOG_LEVEL=info
ENABLE_DEBUG=false
