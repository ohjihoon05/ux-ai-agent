{
  "name": "component-library-website",
  "version": "1.0.0",
  "type": "module",
  "description": "Component library website with Vite and TailwindCSS",
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:vite\"",
    "dev:server": "node src/api/server.js",
    "dev:vite": "vite",
    "build": "npm run build:db && npm run build:vite",
    "build:db": "node src/db/init.js && sqlite3 database.db < src/db/optimize.sql",
    "build:vite": "vite build",
    "build:mcp": "cd ../mcp-server && npm run build",
    "build:all": "npm run build && npm run build:mcp",
    "preview": "vite preview",
    "start": "NODE_ENV=production node src/api/server.js",
    "test": "vitest",
    "lint": "echo 'Linting...'",
    "clean": "rm -rf dist database.db node_modules"
  },
  "dependencies": {
    "better-sqlite3": "^11.0.0",
    "concurrently": "^8.2.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "express-validator": "^7.2.1",
    "figma-api": "^2.0.2-beta",
    "helmet": "^8.1.0"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.0",
    "postcss": "^8.4.0",
    "tailwindcss": "^3.4.0",
    "vite": "^5.2.0",
    "vitest": "^1.5.0"
  }
}
